    instance IhoS102Check::ValidationCheck {
      dev_id = "102_Dev5011"
      check_id = "102_5004"
      classification = error
      check_message = "[X] interior data holes with a size less than [N] nodes were found. Review for potential data gaps."
      check_description = "Reports the number of interior no-data regions (\"holes\") in <FTYPE> that are smaller than a specified size threshold N. This check identifies undesirable holes within the data footprint. It performs a connected components analysis on no-data cells, discards the main exterior region, and counts the remaining interior regions (\"holes\") that have a size less than a threshold N."
      check_solution = "(Notification only)"
      standards_document_reference = "N/A"
      clause_reference = "N/A"
      data_quality_measure = [
        "spatial object"
      ]
      introduced = "3.0.0"
      terminate_if_failure = true
      uploaded_date = "2025-09-30T00:00:00"
      notes = "The size threshold N should be a configurable parameter in the validation software. A sensible default could be proposed (e.g., N=10)."
    },
    instance IhoS102Check::ValidationCheck {
      dev_id = "102_Dev5012"
      check_id = "102_5005"
      classification = error
      check_message = "[X] isolated data groups with a size less than [N] nodes were found. Review for potential data speckling or noise."
      check_description = "Reports the number of contiguous data groups in <FTYPE> that are smaller than a specified size threshold N. This check identifies data speckling by performing a connected components analysis to find all distinct \"islands\" of valid data cells. It then counts how many of these islands have a size less than a threshold N."
      check_solution = "(Notification only)"
      standards_document_reference = "N/A"
      clause_reference = "N/A"
      data_quality_measure = [
        "spatial object"
      ]
      introduced = "3.0.0"
      terminate_if_failure = true
      uploaded_date = "2025-09-30T00:00:00"
      notes = "The size threshold N should be a configurable parameter in the validation software. Recommend a default of N=4."
    },
